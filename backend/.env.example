# MiZeMi backend environment (MASTER_SPEC.md §16).
#
# Copy to `.env` and adjust as needed. Every variable is prefixed MIZEMI_ and
# has a safe default baked into app/infrastructure/settings.py — this file
# documents the full set and its defaults. Real `.env` files are gitignored;
# never commit secrets.

# development | test | production
MIZEMI_ENV=development

# SQLAlchemy database URL (SQLite for the MVP).
MIZEMI_DATABASE_URL=sqlite:///./mizemi.db

# Bind address / port for the backend process.
MIZEMI_HOST=127.0.0.1
MIZEMI_PORT=8000

# Comma-separated list of allowed CORS origins (the Vite dev server by default).
MIZEMI_CORS_ORIGINS=http://localhost:5173

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIZEMI_LOG_LEVEL=INFO
