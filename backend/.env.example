# Copy to backend/.env for local use. Never commit real credentials.
# APP_ENV, DATABASE_URL, HOST, PORT and FRONTEND_ORIGIN are supported aliases.
# If both forms exist, MIZEMI_* takes precedence.
APP_ENV=development
DATABASE_URL=sqlite:///./mizemi.db
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MIZEMI_LOG_LEVEL=INFO
MIZEMI_QUESTIONS_PER_GAME=20
MIZEMI_QUESTION_TIME_LIMIT_SECONDS=20
MIZEMI_MAX_PLAYERS_PER_ROOM=50
MIZEMI_ROOM_IDLE_TTL_MINUTES=120
MIZEMI_RETENTION_DAYS=7

# ─── Optional AI question generation (§12.7, bring-your-own-key) ──────────
# Keep MIZEMI_AI_ENABLED=false in any environment that must not reach an
# external service. When true, every room may opt into AI-generated
# questions. The key stays only in this file (gitignored) and in process
# memory — it is never written to the database, logs or responses.
MIZEMI_AI_ENABLED=false
# MIZEMI_ANTHROPIC_API_KEY=sk-ant-...        # paste only locally, never commit
# MIZEMI_ANTHROPIC_MODEL=claude-sonnet-5
# MIZEMI_AI_MAX_GAMES_PER_HOUR=20
# MIZEMI_AI_REQUEST_TIMEOUT_SECONDS=90

# Render: APP_ENV=production, HOST=0.0.0.0, PORT supplied by Render.
# FRONTEND_ORIGIN=https://YOUR-FRONTEND.onrender.com (no trailing slash).
# Set DATABASE_URL privately to Neon's PostgreSQL URL, including sslmode=require.
# Production rejects SQLite, missing TLS, wildcard origins and non-HTTPS origins.
