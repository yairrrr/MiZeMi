# Only PUBLIC backend origins belong in Vite variables. Never put secrets here.
# Empty values use the local Vite REST/WebSocket proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
# Render examples (replace YOUR-BACKEND with the actual service name):
# VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
# VITE_WS_BASE_URL=wss://YOUR-BACKEND.onrender.com
# Old VITE_MIZEMI_API_BASE_URL / VITE_MIZEMI_WS_BASE_URL remain supported.
